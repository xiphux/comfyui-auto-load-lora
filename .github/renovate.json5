{
	// Keeps the dev dependencies (uv.lock) and the SHA-pinned GitHub Actions
	// current. The node itself has no runtime dependencies. A slimmed-down
	// version of the config in openai-api-bridge. Updates arrive on a weekly
	// timetable rather than as they are released: see `schedule` below and the
	// groups in packageRules.
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	extends: ['config:recommended'],

	// Rebase whenever a branch falls behind main, not only when it conflicts.
	rebaseWhen: 'behind-base-branch',

	// Most malicious PyPI publishes and hijacked action tags are found and pulled
	// within days, and most of these merge unattended.
	minimumReleaseAge: '7 days',

	dependencyDashboard: true,

	// The weekly timetable, and the slot for anything the groups in
	// packageRules do not claim: Sunday, 00:00-05:59 UTC. Each group has a day
	// of its own --
	//
	//   Mon  lock file maintenance     Thu  test and build
	//   Tue  aws                       Fri  production dependencies
	//   Wed  lint and format           Sat  github actions
	//   Sun  everything else: majors, 0.x packages, pnpm, images
	//
	// -- the same days in every repository that has the group. This is where
	// the CI minutes go: before it, every release that cleared the cooldown
	// was a pull request of its own, and the AWS SDK, which publishes almost
	// daily, opened ten to twelve in 19 days in each repository using it.
	// Replayed against ten days of real updates, this timetable raises about
	// 60% fewer pull requests, and every one saved is a CI run (and, where
	// the default branch deploys, a deploy).
	//
	// A day per group rather than one weekly slot for all of them, because of
	// the up-to-date rule in branch protection: open together, every merge
	// would put the others behind and re-run their CI, so six pull requests
	// would cost 6+5+4+3+2+1 runs. Spread out, one is usually open at a time.
	//
	// Six hours, because Mend's free plan runs Renovate about every four, so a
	// slot always holds a run. Wider would let more runs fall in it, and each
	// can open another pull request for releases that aged in the meantime.
	// Outside its slot a branch is still rebased and updated
	// (`updateNotScheduled`), so nothing already open waits for next week. To
	// take something early, tick it under "Awaiting Schedule" on the
	// dependency dashboard.
	//
	// Nothing hurries Renovate between its runs any more. A workflow used to
	// wake it after every merge so the next pull request rebased in minutes
	// rather than hours; with one or two open a week, hours are fine.
	schedule: ['* 0-5 * * 0'],

	// Weekly, re-resolve the whole of uv.lock within the ranges already
	// declared. Renovate otherwise updates only what pyproject.toml names, so a
	// transitive dependency moves only when something above it does. CI gates
	// it like any other update, so it merges unattended. Monday's slot in the
	// timetable (see `schedule`).
	lockFileMaintenance: {
		enabled: true,
		automerge: true,
		schedule: ['* 0-5 * * 1'],
	},

	automergeStrategy: 'merge',
	// GitHub's own auto-merge, so a PR lands the moment its required checks
	// pass. Needs branch protection with required checks on `main`; without
	// them GitHub declines to arm it and Renovate merges during its own run.
	platformAutomerge: true,

	commitMessagePrefix: 'deps:',
	labels: ['dependencies'],

	packageRules: [
		{
			// pyproject.toml states floors (`ruff>=0.16.9`) and uv.lock states what
			// is installed. The default `auto` strategy changes nothing when an
			// update already satisfies an open-ended floor, so it would raise
			// almost no PRs; `update-lockfile` moves the lock instead.
			matchManagers: ['pep621'],
			rangeStrategy: 'update-lockfile',
		},
		{
			matchManagers: ['pep621'],
			matchDepTypes: ['dependency-groups'],
			commitMessagePrefix: 'deps(dev):',
		},
		{
			matchManagers: ['github-actions'],
			commitMessagePrefix: 'ci:',
		},

		// What auto-merges: patch and minor, except minors of 0.x packages;
		// majors and prereleases never.
		{
			matchUpdateTypes: ['patch', 'minor'],
			automerge: true,
		},
		{
			matchUpdateTypes: ['minor'],
			matchCurrentVersion: '/^v?0\\./',
			automerge: false,
		},
		{
			// ruff is 0.x, but CI judges its minors directly: a new rule or
			// formatting change fails the lint job rather than slipping through.
			matchPackageNames: ['ruff'],
			matchUpdateTypes: ['minor'],
			matchCurrentVersion: '/^v?0\\./',
			automerge: true,
		},
		{
			matchUpdateTypes: ['major'],
			// A major never auto-merges, so rebasing it on every unrelated merge
			// just re-runs CI on a PR nobody is about to land.
			rebaseWhen: 'conflicted',
			automerge: false,
		},
		{
			matchCurrentVersion: '/-/',
			automerge: false,
		},

		// The groups, each in its slot in the timetable (see `schedule`). Later
		// rules win, so the ones matching by name take packages out of the two
		// that match by dependency type. Lists are the same in every repository,
		// names it does not use included, so a package lands in the same group
		// wherever it turns up.
		//
		// Every group leaves out 0.x packages (the negated matchCurrentVersion).
		// A 0.x minor does not auto-merge (see above), and a group auto-merges
		// only if every update in it does, so one would hold its whole group
		// open; left out, a 0.x package raises its own pull request on Sunday.
		//
		// The cost of batching: an update that fails CI holds the rest of its
		// group until it is fixed, or excluded by a rule of its own. Majors are
		// never grouped, and a security fix ignores all of this -- Renovate
		// applies `vulnerabilityAlerts` after these rules, and with `force`.
		//
		// One rule after these is this repository's own: ruff, 0.x but with
		// minors that auto-merge here, goes back into its group.
		{
			groupName: 'production dependencies',
			// npm and Cargo; pep621.
			matchDepTypes: ['dependencies', 'project.dependencies'],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 5'],
		},
		{
			groupName: 'test and build',
			// npm; Cargo; pep621's [dependency-groups], extras and build backend.
			matchDepTypes: [
				'devDependencies',
				'dev-dependencies',
				'build-dependencies',
				'dependency-groups',
				'project.optional-dependencies',
				'build-system.requires',
			],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 4'],
		},
		{
			groupName: 'lint and format',
			matchPackageNames: [
				'eslint',
				'eslint-*',
				'@eslint/**',
				'@*/eslint-*',
				'typescript-eslint',
				'@typescript-eslint/**',
				'globals',
				'prettier',
				'prettier-*',
				'knip',
				'lint-staged',
				'husky',
				'publint',
				'ruff',
				'deptry',
				'pre-commit',
				'pre-commit/pre-commit-hooks',
			],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 3'],
		},
		{
			groupName: 'aws',
			matchPackageNames: [
				'@aws-sdk/**',
				'aws-cdk',
				'aws-cdk-lib',
				'cdk-nag',
				'aws-xray-sdk-core',
				'@types/aws-lambda',
				'aws-ses-v2-local',
				'amazon/dynamodb-local',
				'boto3',
				'botocore',
			],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 2'],
		},
		{
			groupName: 'github actions',
			matchManagers: ['github-actions'],
			matchUpdateTypes: ['minor', 'patch', 'digest'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 6'],
		},
		{
			// zizmor-action runs only zizmor versions it knows, and the version it
			// runs (its `version:` input, tracked as the zizmor image) is in the
			// group above. The action is 0.x, so the exclusion would send it to
			// Sunday, a day after a version it may not know yet, so it is kept
			// with the group. A minor of it does not auto-merge (it is 0.x), so one
			// holds the group for review.
			groupName: 'github actions',
			matchPackageNames: ['zizmorcore/zizmor-action'],
			matchUpdateTypes: ['minor', 'patch', 'digest'],
			schedule: ['* 0-5 * * 6'],
		},
		{
			// The timetable leaves 0.x packages out of its groups only because
			// their minors do not auto-merge; ruff's do (see above).
			groupName: 'lint and format',
			matchPackageNames: ['ruff'],
			matchUpdateTypes: ['minor', 'patch'],
			schedule: ['* 0-5 * * 3'],
		},
	],

	// Renovate's own vulnerability source (osv.dev), independent of whether the
	// Renovate app can read this repository's Dependabot alerts.
	osvVulnerabilityAlerts: true,

	// A vulnerable package is proposed regardless of the cooldown above.
	vulnerabilityAlerts: {
		minimumReleaseAge: null,
		automerge: false,
	},
}
