{
	// Keeps the dev dependencies (uv.lock) and the SHA-pinned GitHub Actions
	// current. The node itself has no runtime dependencies.
	//
	// Almost everything comes from the shared presets, xiphux/renovate-config:
	// the cooldowns, the auto-merge policy, the weekly timetable and its
	// groups, lockfile maintenance and the vulnerability alerts (default.json5),
	// and uv's `update-lockfile` strategy and ruff's 0.x exception
	// (python.json5), each with its rationale beside it. What follows is only
	// what differs here. This file's packageRules are appended after the
	// presets', and later rules win.
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	extends: [
		'github>xiphux/renovate-config:default.json5',
		'github>xiphux/renovate-config:python.json5',
	],

	// "deps: ...", "deps(dev): ..." and "ci: ...".
	commitMessagePrefix: 'deps:',

	packageRules: [
		{
			matchManagers: ['pep621'],
			matchDepTypes: ['dependency-groups'],
			commitMessagePrefix: 'deps(dev):',
		},
		{
			matchManagers: ['github-actions'],
			commitMessagePrefix: 'ci:',
		},
	],
}
